<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Type scale: Display / Headline / Title / Body / Caption -->
    <style name="TextAppearance.FixIT.Display" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_display</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.FixIT.Headline" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_headline</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.FixIT.Title" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_title</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.FixIT.Body" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.FixIT.BodySecondary" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_body</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>
    <style name="TextAppearance.FixIT.Caption" parent="@android:style/TextAppearance">
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textColor">@color/ink_secondary</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <!-- White card, 1dp border, 14dp corners -->
    <style name="Widget.FixIT.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card</item>
        <item name="cardCornerRadius">@dimen/card_radius</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeColor">@color/border</item>
        <item name="strokeWidth">@dimen/card_stroke</item>
    </style>

    <!-- Pill used for status / priority / SLA. Colour is tinted in code from colour resources. -->
    <style name="Widget.FixIT.Chip" parent="">
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:paddingStart">@dimen/chip_pad_h</item>
        <item name="android:paddingEnd">@dimen/chip_pad_h</item>
        <item name="android:paddingTop">@dimen/chip_pad_v</item>
        <item name="android:paddingBottom">@dimen/chip_pad_v</item>
        <item name="android:textSize">@dimen/text_caption</item>
        <item name="android:textStyle">bold</item>
        <item name="android:fontFamily">sans-serif</item>
    </style>

    <style name="Widget.FixIT.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">@dimen/zero</item>
        <item name="android:insetBottom">@dimen/zero</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Widget.FixIT.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="cornerRadius">@dimen/button_radius</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">@dimen/zero</item>
        <item name="android:insetBottom">@dimen/zero</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/border</item>
    </style>
    <style name="Widget.FixIT.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:insetTop">@dimen/zero</item>
        <item name="android:insetBottom">@dimen/zero</item>
        <item name="android:textAllCaps">false</item>
    </style>

    <style name="Widget.FixIT.FilterChip" parent="Widget.Material3.Chip.Filter">
        <item name="android:textSize">@dimen/text_body</item>
    </style>
</resources>
